# arxiv-organizer Configuration
# ==============================
# Copy this file to .env and fill in your values

# Google API Key for AI features (optional)
# Get one free at: https://aistudio.google.com/app/apikey
#
# AI features include:
#   - Smart Judge: Filter downloads by natural language criteria
#   - AI Classification: Organize papers into custom topics
#   - AI Enrichment: Auto-generate summaries and tags
#
# Leave empty or remove this line to use the package without AI features
GOOGLE_API_KEY=your_api_key_here
